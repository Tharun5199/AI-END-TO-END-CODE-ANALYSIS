# Copy this file to .env (exactly ".env" -- not ".env.txt") and fill in your
# own values. .env is gitignored; never put a real key in THIS file, because
# .env.example IS committed to GitHub.

# --- LLM (Groq -- free tier, no cost) ---------------------------------
# Get a free key at https://console.groq.com/keys  (it starts with gsk_)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (local sentence-transformers -- free, no key needed) --
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store / cloned repos (relative to the project folder) -----
CHROMA_PERSIST_DIR=vectorstore
REPOS_DIR=repos

# --- Chunking / retrieval ------------------------------------------------
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
TOP_K=5
MAX_FILE_SIZE_KB=512
MAX_FILES=1500
MAX_HISTORY_TURNS=6

# --- Flask ----------------------------------------------------------------
FLASK_SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=false
PORT=8080
